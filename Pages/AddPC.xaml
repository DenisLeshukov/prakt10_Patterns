<Page x:Class="prakt10_Leshukov.Pages.AddPC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt10_Leshukov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddPC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
       
            <Label Grid.Column="1" Grid.Row="0">Добавление сборки</Label>
        <Label Grid.Column="1" Grid.Row="1">Процессор</Label>
        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding CPU}" Grid.Column="1" Grid.Row="1" Height="30" >
            <ComboBoxItem Tag="AMD" Content="AMD"/>
            <ComboBoxItem Tag="Intel" Content="Intel"/>
            <ComboBoxItem Tag="Байкал" Content="Байкал"/>
            
        </ComboBox>
        <Label Grid.Column="1" Grid.Row="2">Видеокарта</Label>
        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding GPU}" Grid.Column="1" Grid.Row="2" Height="30">

            <ComboBoxItem Tag="AMD" Content="AMD"/>
            <ComboBoxItem Tag="Nvidia" Content="Nvidia"/>
            <ComboBoxItem Tag="Intel" Content="Intel"/>

        </ComboBox>
        <Label Grid.Column="1" Grid.Row="3">ОЗУ, ГБ</Label>
        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding RAM}" Grid.Column="1" Grid.Row="3" Height="30">

            <ComboBoxItem Tag="2" Content="2"/>
            <ComboBoxItem Tag="4" Content="4"/>
            <ComboBoxItem Tag="8" Content="8"/>
            <ComboBoxItem Tag="16" Content="16"/>
            <ComboBoxItem Tag="32" Content="32"/>
            <ComboBoxItem Tag="64" Content="64"/>
            <ComboBoxItem Tag="128" Content="128"/>

        </ComboBox>
        <Label Grid.Column="1" Grid.Row="4">Накопитель, ГБ</Label>
        <ComboBox SelectedValuePath="Content" SelectedValue="{Binding Disk}"  Grid.Column="1" Grid.Row="4" Height="30">
            <ComboBoxItem Tag="128" Content="128"/>
            <ComboBoxItem Tag="256" Content="256"/>
            <ComboBoxItem Tag="512" Content="512"/>
            <ComboBoxItem Tag="1024" Content="1024"/>
            <ComboBoxItem Tag="2048" Content="2048"/>
            <ComboBoxItem Tag="4096" Content="4096"/>

        </ComboBox>
        <Button Click="Add" Grid.Column="1" Grid.Row="5" Width="200" Height="30">Добавить</Button>
        
    </Grid>
</Page>
