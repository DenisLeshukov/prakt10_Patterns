<Page x:Class="prakt10_Leshukov.Pages.AddPC"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt10_Leshukov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddPC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
       
            <Label Grid.Column="1" Grid.Row="0">Добавление сборки</Label>
        <Label Grid.Column="1" Grid.Row="1">Процессор</Label>
        <ComboBox Text="{Binding processor}" Grid.Column="1" Grid.Row="1" Height="30" >
            <ComboBoxItem>AMD</ComboBoxItem>
            <ComboBoxItem>Intel</ComboBoxItem>
        </ComboBox>
        <Label Grid.Column="1" Grid.Row="2">Видеокарта</Label>
        <ComboBox Grid.Column="1" Grid.Row="2" Height="30">
            
            <ComboBoxItem>AMD</ComboBoxItem>
            <ComboBoxItem>NVIDIA</ComboBoxItem>
            
        </ComboBox>
        <Label Grid.Column="1" Grid.Row="3">ОЗУ</Label>
        <ComboBox Grid.Column="1" Grid.Row="3" Height="30">

            <ComboBoxItem>2 ГБ</ComboBoxItem>
            <ComboBoxItem>4ГБ</ComboBoxItem>
            <ComboBoxItem>8ГБ</ComboBoxItem>
            <ComboBoxItem>16ГБ</ComboBoxItem>
            <ComboBoxItem>32 ГБ</ComboBoxItem>

        </ComboBox>
        <Label Grid.Column="1" Grid.Row="4">Накопитель</Label>
        <ComboBox  Grid.Column="1" Grid.Row="4" Height="30">
            <ComboBoxItem>128 ГБ</ComboBoxItem>
            <ComboBoxItem>256 ГБ</ComboBoxItem>
            <ComboBoxItem>512 ГБ</ComboBoxItem>
            <ComboBoxItem>1024 ГБ</ComboBoxItem>

        </ComboBox>
        <Button Click="Add" Grid.Column="1" Grid.Row="5" Width="200" Height="30"></Button>
        
    </Grid>
</Page>
