<Page x:Class="prakt10_Leshukov.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt10_Leshukov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView Grid.Column="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <Label>Процессор: </Label>
                                <TextBlock Text="{Binding CPU}"></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <Label>Видеокарта: </Label>
                                <TextBlock Text="{Binding GPU}"></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <Label>ОЗУ:</Label>
                                <TextBlock Text="{Binding OZU}"></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <Label>Накопитель:</Label>
                                <TextBlock Text="{Binding Harddisk}"></TextBlock>
                            </StackPanel>
                            
                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Column="1">
            <Button Click="GoToAdd">Добавить</Button>
        </StackPanel>
    </Grid>
</Page>
