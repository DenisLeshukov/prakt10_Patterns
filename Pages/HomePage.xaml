<Page x:Class="prakt10_Leshukov.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt10_Leshukov.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView SelectedItem="{Binding selectedPC}" ItemsSource="{Binding PCs}" Grid.Column="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical">
                            <StackPanel>
                                <TextBlock Text="{Binding CPU, StringFormat=Процессор: {0}}" ></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                
                                <TextBlock Text="{Binding GPU, StringFormat=Видеокарта: {0}}"></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding RAM, StringFormat=ОЗУ: {0} ГБ}"></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding HardDisk, StringFormat=Накопитель: {0} ГБ}"></TextBlock>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Column="1">
            <Button Click="GoToAdd">Добавить</Button>
            <Button Click="Copy">Клонировать</Button>
            <Button Click="Edit">Изменить</Button>
        </StackPanel>
    </Grid>
</Page>
